# Root di esempio inclusa nel repository. Per le tue note: /srv/markdown
MARKDOWN_ROOT=./notes
HOST=127.0.0.1
PORT=3000
# basic (default), oppure proxy: leggere README prima di usare proxy.
AUTH_MODE=basic
AUTH_USER=folume
AUTH_PASSWORD=replace-with-a-long-password
# Origin pubblico esatto, senza slash finale. Impostare dietro proxy HTTPS.
# PUBLIC_ORIGIN=https://notes.example.com
# Fallback solo per filesystem che non propagano inotify (alcuni mount di rete).
WATCH_USE_POLLING=false
WATCH_POLL_INTERVAL=1500
MAX_FILE_BYTES=5242880
# Solo Docker Compose: UID/GID con accesso in scrittura alla directory host.
# FOLUME_UID=1000
# FOLUME_GID=1000
